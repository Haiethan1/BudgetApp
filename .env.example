# SQLite is stored on the persistent /data mount in Docker.
DATABASE_URL=/data/homebooks.sqlite
# Reserved for snapshot and restore work. Keep it on a separate mount.
BACKUP_DIR=/backups
NODE_ENV=production
PORT=3000
HOSTNAME=0.0.0.0

# Use the exact browser origin on your private network, or your HTTPS origin.
BETTER_AUTH_URL=http://localhost:3000
# Generate separate random values (32+ characters) before first use.
BETTER_AUTH_SECRET=
HOMEBOOKS_SETUP_TOKEN=
# Enable only while registering household members; restart to apply changes.
HOMEBOOKS_REGISTRATION_ENABLED=false
